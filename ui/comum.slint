// Componentes usados por mais de uma tela.

export component Botao inherits Rectangle {
    in property <string> texto;
    in property <bool> ativo: false;
    callback clicado();
    height: 30px;
    min-width: 64px;
    border-radius: 4px;
    background: toque.pressed ? #4a4c53 : (ativo ? #5a4a20 : (toque.has-hover ? #3b3d43 : #33353a));
    border-width: 1px;
    border-color: ativo ? #f0c040 : #45474e;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.texto;
            color: #e6e6e6;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    toque := TouchArea {
        clicked => { root.clicado(); }
    }
}

// nome do botão de ícone sob o mouse, mostrado na barra
export global Dica {
    in-out property <string> texto;
}

// botão pequeno com um ícone (caminho SVG num quadrado de 24); o nome
// aparece na barra enquanto o mouse está em cima
export component BotaoIcone inherits Rectangle {
    in property <string> icone;
    in property <string> dica;
    in property <bool> ativo: false;
    // traço em vez de preenchimento (ícones de linha)
    in property <bool> contorno: false;
    callback clicado();
    width: 28px;
    height: 28px;
    border-radius: 4px;
    background: toque.pressed ? #4a4c53 : (ativo ? #5a4a20 : (toque.has-hover ? #3b3d43 : transparent));
    border-width: 1px;
    border-color: ativo ? #f0c040 : (toque.has-hover ? #45474e : transparent);
    Path {
        x: 6px;
        y: 6px;
        width: 16px;
        height: 16px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icone;
        fill: root.contorno ? transparent : (root.ativo ? #f0c040 : #d6d8dd);
        stroke: root.contorno ? (root.ativo ? #f0c040 : #d6d8dd) : transparent;
        stroke-width: root.contorno ? 1.6px : 0px;
    }
    toque := TouchArea {
        clicked => { root.clicado(); }
        changed has-hover => {
            if self.has-hover {
                Dica.texto = root.dica;
            } else if Dica.texto == root.dica {
                Dica.texto = "";
            }
        }
    }
}

