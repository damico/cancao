import { ComboBox, ScrollView, Slider } from "std-widgets.slint";
import { Botao, BotaoIcone, Dica, Icones } from "comum.slint";
import { TelaAcervo, ObraVis, SugestaoVis } from "acervo.slint";

// Piano roll: visualizador temporal da partitura tocada pelo player.
// O Rust calcula as posições e só entrega o que está visível; aqui só se
// desenha e se repassam os gestos.

export struct NotaVis {
    id: int,
    x: length,
    y: length,
    w: length,
    h: length,
    cor: color,
    rotulo: string,
    // 0 = futura, 1 = soando, 2 = tocada
    estado: int,
    selecionada: bool,
}

export struct LinhaVis {
    x: length,
    // 0 = subdivisão, 1 = tempo, 2 = compasso
    peso: int,
}

export struct RotuloVis {
    x: length,
    texto: string,
}

export struct TeclaVis {
    y: length,
    h: length,
    preta: bool,
    rotulo: string,
    soando: bool,
    // divisão entre duas brancas vizinhas abaixo desta (C sobre B, F sobre E)
    divisao: bool,
}

export struct BarraVis {
    x: length,
    nivel: float,
    cor: color,
    selecionada: bool,
}

// uma pisada de pedal na sua faixa (0 sustain, 1 sostenuto, 2 una corda)
export struct FaixaVis {
    id: int,
    x: length,
    w: length,
    linha: int,
    nivel: float,
    selecionada: bool,
}

// um sistema da partitura tradicional já rasterizado, na posição da tela
export struct SistemaVis {
    imagem: image,
    x: length,
    y: length,
    w: length,
    h: length,
}

// um pedaço de sistema na tira alinhada ao tempo: o trecho
// [clip-x, clip-x + clip-w) da imagem (px físicos) posto em [x, x + w)
export struct FatiaVis {
    imagem: image,
    clip-x: int,
    clip-w: int,
    clip-h: int,
    x: length,
    w: length,
    h: length,
}

// uma nota desenhada na partitura (para destaque e clique)
export struct MarcaVis {
    id: int,
    x: length,
    y: length,
    w: length,
    h: length,
    // 0 = nada, 1 = soando, 2 = selecionada
    estado: int,
}

// uma curva já em comandos de caminho (SVG): no plano emocional
// (coordenadas 0..200) ou na faixa de emoção (pixels)
export struct CurvaVis {
    comandos: string,
    cor: color,
    destaque: bool,
}

export struct LegendaVis {
    texto: string,
    cor: color,
}

// cor de cada pedal: sustain, sostenuto, una corda
global Pedais {
    out property <[color]> cores: [#4f86c6, #5fae6a, #a77bd0];
    out property <[string]> nomes: ["Sustain", "Sostenuto", "Una corda"];
}

// luz de um pedal na barra: acende e enche com a profundidade (0..1); o
// número só aparece no meio pedal
component LuzPedal inherits Rectangle {
    in property <int> pedal;
    in property <float> nivel;
    height: 30px;
    width: 74px;
    border-radius: 4px;
    border-width: 1px;
    border-color: nivel > 0 ? Pedais.cores[pedal] : #45474e;
    background: #2b2c30;
    clip: true;
    Rectangle {
        x: 0px;
        width: parent.width * nivel;
        background: Pedais.cores[pedal].with-alpha(0.55);
    }
    Text {
        text: nivel > 0 && nivel < 1 ? Pedais.nomes[pedal] + " " + Math.round(nivel * 100) + "%" : Pedais.nomes[pedal];
        color: nivel > 0 ? #ffffff : #8a8c92;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// interpretações: nome e cor, na ordem do motor de expressão
global Interpretacoes {
    out property <[string]> nomes: ["Neutra", "Contemplativa", "Enérgica", "Melancólica"];
    out property <[color]> cores: [#a8acb4, #5fb3a1, #e8915a, #8a7fd4];
}

// botão de uma interpretação: ponto com a cor dela (é também a legenda do
// plano emocional)
component BotaoPerfil inherits Rectangle {
    in property <int> perfil;
    in property <bool> ativo;
    callback clicado();
    height: 26px;
    border-radius: 4px;
    background: toque.has-hover ? #3b3d43 : #2f3135;
    border-width: 1px;
    border-color: ativo ? Interpretacoes.cores[perfil] : #45474e;
    HorizontalLayout {
        padding-left: 8px;
        spacing: 6px;
        alignment: start;
        Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: Interpretacoes.cores[perfil];
        }
        Text {
            text: Interpretacoes.nomes[perfil];
            color: ativo ? #ffffff : #b8bac0;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
    toque := TouchArea {
        clicked => { root.clicado(); }
    }
}

// plano Valência x Ativação (circumplexo de Russell): as trajetórias das
// interpretações e o ponto de agora
component PlanoEmocional inherits Rectangle {
    in property <[CurvaVis]> curvas;
    in property <float> valencia;
    in property <float> ativacao;
    in property <bool> agora-visivel;
    in property <color> cor-agora;
    background: #18191c;
    border-radius: 4px;
    clip: true;
    Rectangle {
        x: parent.width / 2;
        width: 1px;
        background: #4a4c53;
    }
    Rectangle {
        y: parent.height / 2;
        height: 1px;
        background: #4a4c53;
    }
    Text { x: 6px; y: 4px; text: "Tensão"; color: #c08a6a; font-size: 10px; }
    Text { x: parent.width - self.width - 6px; y: 4px; text: "Euforia"; color: #d39a6a; font-size: 10px; }
    Text { x: 6px; y: parent.height - self.height - 4px; text: "Melancolia"; color: #8a9fd4; font-size: 10px; }
    Text { x: parent.width - self.width - 6px; y: parent.height - self.height - 4px; text: "Serenidade"; color: #6abf9a; font-size: 10px; }
    Text { x: parent.width / 2 + 4px; y: 4px; text: "ativação +"; color: #6c6f76; font-size: 9px; }
    Text { x: parent.width - self.width - 4px; y: parent.height / 2 + 2px; text: "valência +"; color: #6c6f76; font-size: 9px; }
    for c in root.curvas: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 200;
        viewbox-height: 200;
        commands: c.comandos;
        stroke: c.cor;
        stroke-width: c.destaque ? 2.5px : 1px;
        opacity: c.destaque ? 1.0 : 0.45;
        fill: transparent;
    }
    if root.agora-visivel: Rectangle {
        x: (root.valencia + 1) / 2 * parent.width - 6px;
        y: (1 - root.ativacao) / 2 * parent.height - 6px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        border-width: 2px;
        border-color: #ffffff;
        background: root.cor-agora;
    }
    if root.agora-visivel: Text {
        x: (root.valencia + 1) / 2 * parent.width + 8px;
        y: (1 - root.ativacao) / 2 * parent.height - 7px;
        text: "Agora";
        color: #ffffff;
        font-size: 10px;
    }
}

component Info inherits Text {
    color: #b8bac0;
    vertical-alignment: center;
}

export component PianoRoll inherits Window {
    title: "cancao - " + root.titulo;
    preferred-width: 1400px;
    preferred-height: 860px;
    min-width: 900px;
    min-height: 500px;
    background: #1b1c1f;
    default-font-size: 13px;

    in property <string> titulo;
    in property <string> bpm;
    in property <string> posicao;
    in property <string> formula;
    in property <string> zoom;
    in property <string> grade;
    in property <string> modelo;
    in property <string> modo-cor;
    in property <bool> tocando;
    in property <string> info: "Clique numa nota ou num pedal para ver os detalhes.";
    // coluna da direita: 0 interpretação, 1 nota, 2 áudio
    in-out property <int> aba: 0;
    // motor de expressão e emoção percebida
    in property <int> interpretacao: 0;
    in property <string> resumo-interpretacao;
    in property <[CurvaVis]> curvas-plano;
    in property <[CurvaVis]> curvas-emocao;
    in property <float> agora-valencia;
    in property <float> agora-ativacao;
    in property <bool> agora-visivel;
    in property <string> mensagem;
    in property <[LegendaVis]> legenda;
    in property <[NotaVis]> notas;
    in property <[LinhaVis]> linhas;
    in property <[RotuloVis]> rotulos;
    in property <[TeclaVis]> teclas;
    in property <[BarraVis]> barras;
    in property <[FaixaVis]> pedais;
    // posição de cada pedal agora (sustain, sostenuto, una corda), 0..1
    in property <[float]> pe-agora: [0, 0, 0];
    // painel da partitura tradicional (Live Score Panel)
    // modo: 0 = oculto, 1 = compacto, 2 = expandido, 3 = tela cheia
    in-out property <int> modo-partitura: 1;
    in property <length> altura-compacta: 150px;
    in-out property <length> altura-expandida: 340px;
    in-out property <bool> seguir: true;
    // partitura alinhada ao tempo do piano roll
    in-out property <bool> alinhado: false;
    in property <[FatiaVis]> fatias;
    in property <length> cursor-x;
    in property <length> cursor-y;
    in property <length> cursor-h;
    in property <bool> cursor-visivel;
    in property <string> status-partitura;
    in property <string> zoom-partitura;
    in property <[SistemaVis]> sistemas;
    in property <[MarcaVis]> marcas;
    out property <length> partitura-largura: corpo-partitura.width;
    out property <length> partitura-altura: corpo-partitura.height;
    in property <[string]> dispositivos;
    in-out property <int> dispositivo-atual;
    in-out property <float> volume: 100;
    in property <length> playhead-x;
    in property <bool> playhead-visivel;

    // tamanho da área do roll, lido pelo Rust a cada quadro (atualizado pelo
    // próprio roll, que sai do layout com a partitura em tela cheia)
    in-out property <length> roll-largura: 1000px;
    in-out property <length> roll-altura: 600px;

    // tela: 0 = piano roll, 1 = acervo de partituras
    in-out property <int> tela: 0;
    in property <string> acervo-pasta;
    in property <int> acervo-estado;
    in property <float> acervo-progresso;
    in property <string> acervo-status;
    in property <string> acervo-titulo-lista;
    in property <[ObraVis]> acervo-resultados;
    in property <[SugestaoVis]> acervo-sugestoes;
    in-out property <string> acervo-consulta;
    in-out property <bool> acervo-so-piano;
    in-out property <int> acervo-selecionada;
    callback abrir-acervo();
    callback acervo-buscar();
    callback acervo-escolher-pasta();
    callback acervo-reindexar();
    callback acervo-abrir(int, bool);
    callback abrir();
    callback tocar();
    callback pausar();
    callback parar();
    callback alternar-modelo();
    callback zoom-mais();
    callback zoom-menos();
    callback alternar-cor();
    // dx, dy, ctrl, shift, x e y do cursor dentro do roll
    callback rolar(float, float, bool, bool, length, length);
    callback clicar-nota(int);
    callback clicar-regua(length);
    callback clicar-fundo();
    callback clicar-pedal(int);
    callback escolher-interpretacao(int);
    callback escolher-dispositivo(string);
    callback mudar-volume(float);
    callback clicar-partitura(int);
    callback rolar-partitura(float);
    callback zoom-partitura-mais();
    callback zoom-partitura-menos();
    callback mudou-partitura();

    VerticalLayout {
        // barra superior: transporte, título, andamento, posição, zoom
        Rectangle {
            height: 40px;
            background: #26272b;
            HorizontalLayout {
                padding: 6px;
                padding-left: 9px;
                spacing: 6px;
                BotaoIcone {
                    icone: Icones.abrir;
                    dica: "Abrir arquivo";
                    clicado => { root.abrir(); }
                }
                BotaoIcone {
                    icone: Icones.acervo;
                    dica: "Acervo de partituras";
                    clicado => { root.abrir-acervo(); }
                }
                Rectangle { width: 6px; }
                BotaoIcone {
                    icone: Icones.tocar;
                    dica: "Tocar";
                    ativo: root.tocando;
                    clicado => { root.tocar(); }
                }
                BotaoIcone {
                    icone: Icones.pausar;
                    dica: "Pausar";
                    clicado => { root.pausar(); }
                }
                BotaoIcone {
                    icone: Icones.parar;
                    dica: "Parar";
                    clicado => { root.parar(); }
                }
                Rectangle { width: 6px; }
                Info { text: root.bpm + " BPM"; }
                Info { text: root.posicao; font-family: "monospace"; }
                Info { text: root.formula; }
                BotaoIcone {
                    icone: Icones.menos;
                    dica: "Menos zoom no piano roll";
                    clicado => { root.zoom-menos(); }
                }
                Info { text: root.zoom; }
                BotaoIcone {
                    icone: Icones.mais;
                    dica: "Mais zoom no piano roll";
                    clicado => { root.zoom-mais(); }
                }
                Info { text: "Grade " + root.grade; }
                // o pé: os três pedais agora
                Rectangle { width: 4px; }
                for i in 3: LuzPedal {
                    pedal: i;
                    nivel: root.pe-agora[i];
                }
                for l in root.legenda: HorizontalLayout {
                    spacing: 4px;
                    alignment: center;
                    Rectangle {
                        width: 10px;
                        height: 10px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 5px;
                        background: l.cor;
                    }
                    Info { text: l.texto; }
                }
                // o nome do ícone sob o mouse
                Info {
                    text: Dica.texto;
                    color: #f0c040;
                    horizontal-alignment: right;
                    overflow: elide;
                    min-width: 0px;
                    horizontal-stretch: 1;
                }
                BotaoIcone {
                    icone: Icones.cores;
                    dica: root.modo-cor + " (clique para trocar)";
                    clicado => { root.alternar-cor(); }
                }
                BotaoIcone {
                    icone: Icones.corda;
                    contorno: true;
                    dica: root.modelo + " (clique para trocar)";
                    clicado => { root.alternar-modelo(); }
                }
            }
        }

        // painel da partitura: barra com os modos, depois o corpo
        Rectangle {
            height: 36px;
            background: #2c2d31;
            HorizontalLayout {
                padding: 4px;
                padding-left: 9px;
                spacing: 6px;
                Text {
                    text: "Partitura";
                    color: #f2f2f2;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                BotaoIcone {
                    icone: Icones.ocultar;
                    dica: "Ocultar a partitura";
                    ativo: root.modo-partitura == 0;
                    clicado => { root.modo-partitura = 0; root.mudou-partitura(); }
                }
                BotaoIcone {
                    icone: Icones.compacto;
                    dica: "Partitura compacta";
                    ativo: root.modo-partitura == 1;
                    clicado => { root.modo-partitura = 1; root.mudou-partitura(); }
                }
                BotaoIcone {
                    icone: Icones.expandir;
                    dica: "Partitura expandida";
                    ativo: root.modo-partitura == 2;
                    clicado => { root.modo-partitura = 2; root.mudou-partitura(); }
                }
                BotaoIcone {
                    icone: Icones.tela-cheia;
                    dica: "Partitura em tela cheia";
                    ativo: root.modo-partitura == 3;
                    clicado => { root.modo-partitura = 3; root.mudou-partitura(); }
                }
                Rectangle { width: 6px; }
                BotaoIcone {
                    icone: Icones.alinhar;
                    dica: "Alinhar a partitura ao tempo do piano roll";
                    ativo: root.alinhado;
                    clicado => { root.alinhado = !root.alinhado; root.mudou-partitura(); }
                }
                BotaoIcone {
                    icone: Icones.seguir;
                    dica: "Seguir a execução";
                    ativo: root.seguir;
                    clicado => { root.seguir = !root.seguir; root.mudou-partitura(); }
                }
                Rectangle { width: 6px; }
                BotaoIcone {
                    icone: Icones.menos;
                    dica: "Menos zoom na partitura";
                    clicado => { root.zoom-partitura-menos(); }
                }
                Info { text: root.zoom-partitura; }
                BotaoIcone {
                    icone: Icones.mais;
                    dica: "Mais zoom na partitura";
                    clicado => { root.zoom-partitura-mais(); }
                }
                Info {
                    text: root.status-partitura;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }
        corpo-partitura := Rectangle {
            property <length> fixa: root.modo-partitura == 0 ? 0px : (root.modo-partitura == 1 ? root.altura-compacta : root.altura-expandida);
            min-height: root.modo-partitura == 3 ? 60px : fixa;
            max-height: root.modo-partitura == 3 ? 100000px : fixa;
            vertical-stretch: root.modo-partitura == 3 ? 1 : 0;
            background: #e9e5da;
            clip: true;
            // alinhado: a área da partitura coincide com a do roll (depois da
            // coluna do teclado, antes do inspetor)
            area := Rectangle {
            x: root.alinhado ? 64px : 0px;
            width: root.alinhado ? root.roll-largura : parent.width;
            clip: true;
            TouchArea {
                scroll-event(e) => {
                    root.rolar-partitura(e.delta-y / 1px);
                    return accept;
                }
            }
            for f in root.fatias: Image {
                x: f.x;
                y: 0px;
                width: f.w;
                height: f.h;
                source: f.imagem;
                source-clip-x: f.clip-x;
                source-clip-y: 0;
                source-clip-width: f.clip-w;
                source-clip-height: f.clip-h;
                image-fit: fill;
            }
            for s in root.sistemas: Image {
                x: s.x;
                y: s.y;
                width: s.w;
                height: s.h;
                source: s.imagem;
                image-fit: fill;
            }
            for m in root.marcas: Rectangle {
                x: m.x - 2px;
                y: m.y - 2px;
                width: m.w + 4px;
                height: m.h + 4px;
                border-radius: 3px;
                background: m.estado == 1 ? #f0c04088 : (m.estado == 2 ? #4a90e266 : transparent);
                border-width: m.estado == 2 ? 1.5px : 0px;
                border-color: #2a6fc0;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.clicar-partitura(m.id); }
                    scroll-event(e) => {
                        root.rolar-partitura(e.delta-y / 1px);
                        return accept;
                    }
                }
            }
            // cursor de execução
            if root.cursor-visivel: Rectangle {
                x: root.cursor-x - 1px;
                y: root.cursor-y;
                width: 2px;
                height: root.cursor-h;
                background: #e0a020;
            }
            }
        }
        // divisória arrastável (modo expandido)
        Rectangle {
            height: root.modo-partitura == 2 ? 6px : 0px;
            background: divisoria.has-hover || divisoria.pressed ? #f0c040 : #3a3c42;
            divisoria := TouchArea {
                mouse-cursor: row-resize;
                moved => {
                    root.altura-expandida = max(80px, root.altura-expandida + self.mouse-y - self.pressed-y);
                }
            }
        }

        // piano roll e faixas (saem do layout com a partitura em tela cheia)
        if root.modo-partitura != 3: VerticalLayout {
        vertical-stretch: 1;
        HorizontalLayout {
            // coluna do teclado
            VerticalLayout {
                width: 64px;
                Rectangle {
                    height: 28px;
                    background: #26272b;
                }
                Rectangle {
                    background: #101113;
                    clip: true;
                    // as brancas continuam por baixo das pretas, que são mais curtas
                    for t in root.teclas: Rectangle {
                        x: 0px;
                        y: t.y;
                        width: parent.width;
                        height: t.h;
                        background: t.soando && !t.preta ? #f0c040 : #d9d9d9;
                        if t.preta: Rectangle {
                            x: 0px;
                            width: parent.width * 0.62;
                            background: t.soando ? #f0c040 : #1c1c1e;
                        }
                        if t.divisao: Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: #8a8c93;
                        }
                        Text {
                            x: 4px;
                            text: t.rotulo;
                            color: #303030;
                            font-size: 9px;
                            vertical-alignment: center;
                            height: parent.height;
                        }
                    }
                }
            }

            // régua + roll
            VerticalLayout {
                Rectangle {
                    height: 28px;
                    background: #26272b;
                    clip: true;
                    for l in root.linhas: Rectangle {
                        visible: l.peso >= 1;
                        x: l.x;
                        y: l.peso == 2 ? 0px : 20px;
                        width: 1px;
                        height: parent.height - self.y;
                        background: l.peso == 2 ? #8a8c93 : #5a5c63;
                    }
                    for r in root.rotulos: Text {
                        x: r.x + 4px;
                        y: 3px;
                        text: r.texto;
                        color: #d0d2d8;
                        font-size: 11px;
                    }
                    if root.playhead-visivel: Rectangle {
                        x: root.playhead-x - 5px;
                        y: parent.height - 8px;
                        width: 10px;
                        height: 8px;
                        background: #f0c040;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.clicar-regua(self.mouse-x); }
                    }
                }
                roll := Rectangle {
                    background: #232428;
                    clip: true;
                    init => {
                        root.roll-largura = self.width;
                        root.roll-altura = self.height;
                    }
                    changed width => { root.roll-largura = self.width; }
                    changed height => { root.roll-altura = self.height; }
                    // linhas das teclas: as pretas mais escuras
                    for t in root.teclas: Rectangle {
                        x: 0px;
                        y: t.y;
                        width: parent.width;
                        height: t.h;
                        background: t.preta ? #1e1f22 : #26272b;
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: #1a1b1e;
                        }
                    }
                    for l in root.linhas: Rectangle {
                        x: l.x;
                        y: 0px;
                        width: 1px;
                        height: parent.height;
                        background: l.peso == 2 ? #5c5e66 : (l.peso == 1 ? #3c3e44 : #303237);
                    }
                    fundo := TouchArea {
                        clicked => { root.clicar-fundo(); }
                        scroll-event(e) => {
                            root.rolar(e.delta-x / 1px, e.delta-y / 1px, e.modifiers.control, e.modifiers.shift, self.mouse-x, self.mouse-y);
                            return accept;
                        }
                    }
                    for n in root.notas: Rectangle {
                        x: n.x;
                        y: n.y;
                        width: n.w;
                        height: n.h;
                        border-radius: 2px;
                        background: n.cor;
                        opacity: n.estado == 2 ? 0.4 : 1.0;
                        border-width: n.selecionada ? 2px : (n.estado == 1 ? 1px : 0px);
                        border-color: n.selecionada ? #ffffff : #fff0b0;
                        drop-shadow-blur: n.estado == 1 ? 10px : 0px;
                        drop-shadow-color: n.cor;
                        Text {
                            visible: n.w > 14px && n.h >= 9px;
                            x: 3px;
                            height: parent.height;
                            text: n.rotulo;
                            color: #111214;
                            font-size: min(11px, n.h - 1px);
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => { root.clicar-nota(n.id); }
                            scroll-event(e) => {
                                root.rolar(e.delta-x / 1px, e.delta-y / 1px, e.modifiers.control, e.modifiers.shift, n.x + self.mouse-x, n.y + self.mouse-y);
                                return accept;
                            }
                        }
                    }
                    if root.playhead-visivel: Rectangle {
                        x: root.playhead-x - 1px;
                        y: 0px;
                        width: 2px;
                        height: parent.height;
                        background: #f0c040;
                    }
                }
            }

            // coluna da direita em abas: interpretação, nota, áudio (rola
            // quando não cabe, sem empurrar as faixas de baixo)
            Rectangle {
                width: 230px;
                background: #26272b;
                painel := ScrollView {
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, coluna.preferred-height);
                coluna := VerticalLayout {
                    width: painel.visible-width;
                    padding: 10px;
                    spacing: 8px;
                    Text {
                        text: root.titulo;
                        color: #f2f2f2;
                        font-size: 14px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Botao {
                            texto: "Interpretação";
                            min-width: 0px;
                            ativo: root.aba == 0;
                            clicado => { root.aba = 0; }
                        }
                        Botao {
                            texto: "Nota";
                            min-width: 0px;
                            ativo: root.aba == 1;
                            clicado => { root.aba = 1; }
                        }
                        Botao {
                            texto: "Áudio";
                            min-width: 0px;
                            ativo: root.aba == 2;
                            clicado => { root.aba = 2; }
                        }
                    }
                    if root.aba == 0: VerticalLayout {
                        spacing: 4px;
                        GridLayout {
                            spacing: 4px;
                            Row {
                                BotaoPerfil {
                                    perfil: 0;
                                    ativo: root.interpretacao == 0;
                                    clicado => { root.escolher-interpretacao(0); }
                                }
                                BotaoPerfil {
                                    perfil: 1;
                                    ativo: root.interpretacao == 1;
                                    clicado => { root.escolher-interpretacao(1); }
                                }
                            }
                            Row {
                                BotaoPerfil {
                                    perfil: 2;
                                    ativo: root.interpretacao == 2;
                                    clicado => { root.escolher-interpretacao(2); }
                                }
                                BotaoPerfil {
                                    perfil: 3;
                                    ativo: root.interpretacao == 3;
                                    clicado => { root.escolher-interpretacao(3); }
                                }
                            }
                        }
                        HorizontalLayout {
                            alignment: center;
                            PlanoEmocional {
                                width: 180px;
                                height: 180px;
                                curvas: root.curvas-plano;
                                valencia: root.agora-valencia;
                                ativacao: root.agora-ativacao;
                                agora-visivel: root.agora-visivel;
                                cor-agora: Interpretacoes.cores[root.interpretacao];
                            }
                        }
                        Text {
                            text: root.resumo-interpretacao;
                            color: #b8bac0;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                    if root.aba == 1: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: root.info;
                            color: #c8cad0;
                            wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                    if root.aba == 2: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: "Saída";
                            color: #9fa2a8;
                            font-size: 11px;
                        }
                        ComboBox {
                            model: root.dispositivos;
                            current-index <=> root.dispositivo-atual;
                            selected(nome) => { root.escolher-dispositivo(nome); }
                        }
                        Text {
                            text: "Volume: " + round(root.volume) + "%";
                            color: #9fa2a8;
                            font-size: 11px;
                        }
                        Slider {
                            minimum: 0;
                            maximum: 150;
                            value <=> root.volume;
                            changed(v) => { root.mudar-volume(v); }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                }
            }
        }

        // painel inferior: velocity, os três pedais e a emoção percebida
        HorizontalLayout {
            height: 172px;
            VerticalLayout {
                width: 64px;
                Rectangle {
                    height: 74px;
                    background: #26272b;
                    Text {
                        text: "Velocity";
                        color: #b8bac0;
                        font-size: 11px;
                    }
                }
                // rótulo de cada faixa, aceso enquanto o pedal está abaixado
                for i in 3: Rectangle {
                    height: 18px;
                    background: root.pe-agora[i] > 0 ? Pedais.cores[i].with-alpha(0.35) : #26272b;
                    Rectangle {
                        x: 4px;
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: Pedais.cores[i];
                    }
                    Text {
                        x: 14px;
                        text: Pedais.nomes[i];
                        color: root.pe-agora[i] > 0 ? #ffffff : #b8bac0;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    height: 44px;
                    background: #26272b;
                    VerticalLayout {
                        padding-left: 4px;
                        alignment: center;
                        Text { text: "Valência"; color: #7fc8f8; font-size: 10px; }
                        Text { text: "Ativação"; color: #f28c6a; font-size: 10px; }
                    }
                }
            }
            VerticalLayout {
                Rectangle {
                    height: 74px;
                    background: #1f2023;
                    clip: true;
                    for l in root.linhas: Rectangle {
                        visible: l.peso == 2;
                        x: l.x;
                        y: 0px;
                        width: 1px;
                        height: parent.height;
                        background: #3c3e44;
                    }
                    for b in root.barras: Rectangle {
                        x: b.x;
                        y: parent.height - 6px - (parent.height - 12px) * b.nivel;
                        width: 3px;
                        height: (parent.height - 12px) * b.nivel + 6px;
                        background: b.cor;
                        Rectangle {
                            x: -2px;
                            y: 0px;
                            width: 7px;
                            height: 4px;
                            background: b.selecionada ? #ffffff : b.cor;
                        }
                    }
                    if root.playhead-visivel: Rectangle {
                        x: root.playhead-x - 1px;
                        width: 2px;
                        background: #f0c040;
                    }
                }
                Rectangle {
                    height: 54px;
                    background: #1a1b1e;
                    clip: true;
                    for i in 3: Rectangle {
                        y: i * 18px + 17px;
                        height: 1px;
                        background: #26272b;
                    }
                    for p in root.pedais: Rectangle {
                        x: p.x;
                        y: p.linha * 18px + 3px;
                        width: p.w;
                        height: 12px;
                        border-radius: 3px;
                        background: Pedais.cores[p.linha].with-alpha(0.3 + 0.6 * p.nivel);
                        border-width: p.selecionada ? 1px : 0px;
                        border-color: #ffffff;
                        TouchArea {
                            clicked => { root.clicar-pedal(p.id); }
                        }
                    }
                    if root.playhead-visivel: Rectangle {
                        x: root.playhead-x - 1px;
                        width: 2px;
                        background: #f0c040;
                    }
                }
                // emoção percebida ao longo da peça: valência e ativação
                // (-1 embaixo, 1 em cima) da interpretação escolhida, a
                // neutra apagada para comparar
                Rectangle {
                    height: 44px;
                    background: #18191c;
                    clip: true;
                    Rectangle {
                        y: parent.height / 2;
                        height: 1px;
                        background: #2c2e33;
                    }
                    for c in root.curvas-emocao: Path {
                        width: parent.width;
                        height: parent.height;
                        viewbox-width: self.width / 1px;
                        viewbox-height: self.height / 1px;
                        commands: c.comandos;
                        stroke: c.cor;
                        stroke-width: c.destaque ? 1.8px : 1px;
                        opacity: c.destaque ? 1.0 : 0.35;
                        fill: transparent;
                    }
                    if root.playhead-visivel: Rectangle {
                        x: root.playhead-x - 1px;
                        width: 2px;
                        background: #f0c040;
                    }
                }
            }
            Rectangle {
                width: 230px;
                background: #26272b;
                Text {
                    x: 12px;
                    width: parent.width - 24px;
                    text: root.mensagem;
                    color: #9fa2a8;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }
        }
    }

    // a tela do acervo cobre o piano roll (o som continua)
    if root.tela == 1: TelaAcervo {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        pasta: root.acervo-pasta;
        estado: root.acervo-estado;
        progresso: root.acervo-progresso;
        status: root.acervo-status;
        titulo-lista: root.acervo-titulo-lista;
        resultados: root.acervo-resultados;
        sugestoes: root.acervo-sugestoes;
        consulta <=> root.acervo-consulta;
        so-piano <=> root.acervo-so-piano;
        selecionada <=> root.acervo-selecionada;
        buscar => { root.acervo-buscar(); }
        escolher-pasta => { root.acervo-escolher-pasta(); }
        reindexar => { root.acervo-reindexar(); }
        abrir(i, tocar) => { root.acervo-abrir(i, tocar); }
        fechar => { root.tela = 0; }
    }
}
